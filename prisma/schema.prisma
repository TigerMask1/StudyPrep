datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Student {
  id                    String                @id @default(uuid())
  name                  String
  email                 String                @unique
  password              String
  class                 Int                   // 11 or 12
  targetYear            Int                   // e.g. 2027
  programmeStartDate    DateTime              @default(now())
  medium                String                @default("English")
  schoolHours           Json?                 // School timetable
  availableHoursSchool  Float                 @default(4.5)
  availableHoursWeekend Float                 @default(9.0)
  studyPreference       String                @default("mixed") // morning/evening/mixed

  planAtoms             PlanAtom[]
  weakTopicLogs         WeakTopicLog[]
  testResults           TestResult[]
  subtopicStatus        StudentSubtopicStatus[]
  events                Event[]
  performanceHistory    PerformanceHistory[]

  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
}

model Subtopic {
  id            String   @id
  name          String
  subject       String   // Biology, Physics, Chemistry
  class         Int      // 11 or 12
  unit          String
  chapter       String
  topic         String
  pyqFrequency  Int      @default(0) // 0-5
  difficulty    Int      @default(1) // 1-3
  ncertRef      Json?    // { book, chapter, pages }
  keyPoints     String[]
  commonErrors  String[]
  prerequisites String[] // IDs of other subtopics

  studentStatus StudentSubtopicStatus[]
  weakTopicLogs WeakTopicLog[]
  testResults   TestResultSubtopic[]
}

model StudentSubtopicStatus {
  id            String   @id @default(uuid())
  studentId     String
  subtopicId    String
  status        String   @default("not_started") // not_started, in_progress, completed, needs_revision
  performance   Float?   // accuracy score
  lastAttempted DateTime?

  student       Student  @relation(fields: [studentId], references: [id])
  subtopic      Subtopic @relation(fields: [subtopicId], references: [id])

  @@unique([studentId, subtopicId])
}

model PlanAtom {
  id                 String   @id @default(uuid())
  studentId          String
  date               DateTime
  phase              String   // 1A, 1B, 2, 3
  intensityScore     Int
  availableHours     Float
  data               Json     // Full DailyPlanAtom structure
  version            Int      @default(1)
  mutationReason     String?

  student            Student  @relation(fields: [studentId], references: [id])
  auditHistory       PlanAtomVersion[]

  @@unique([studentId, date])
}

model PlanAtomVersion {
  id          String   @id @default(uuid())
  planAtomId  String
  version     Int
  data        Json     // snapshot
  diff        Json?
  reason      String
  createdAt   DateTime @default(now())

  planAtom    PlanAtom @relation(fields: [planAtomId], references: [id])
}

model WeakTopicLog {
  id             String   @id @default(uuid())
  studentId      String
  subtopicId     String
  errorCount     Int      @default(0)
  lastTested     DateTime @default(now())
  errorType      String?  // conceptual, calculation, MCQ trap
  priorityScore  Float    @default(0)
  status         String   @default("active") // active, mastered

  student        Student  @relation(fields: [studentId], references: [id])
  subtopic       Subtopic @relation(fields: [subtopicId], references: [id])

  @@unique([studentId, subtopicId])
}

model TestResult {
  id             String   @id @default(uuid())
  studentId      String
  testType       String   // chapter, unit, mock, etc.
  score          Float
  totalQuestions Int
  correctCount   Int
  wrongCount     Int
  timeTaken      Int      // in minutes
  subjectBreakdown Json?
  date           DateTime @default(now())

  student        Student  @relation(fields: [studentId], references: [id])
  subtopicResults TestResultSubtopic[]
}

model TestResultSubtopic {
  id             String   @id @default(uuid())
  testResultId   String
  subtopicId     String
  isCorrect      Boolean
  timeTaken      Int?

  testResult     TestResult @relation(fields: [testResultId], references: [id])
  subtopic       Subtopic   @relation(fields: [subtopicId], references: [id])
}

model Event {
  id          String   @id @default(uuid())
  studentId   String
  type        String   // SCHOOL_EXAM, HOLIDAY, etc.
  name        String
  startDate   DateTime
  endDate     DateTime
  data        Json?

  student     Student  @relation(fields: [studentId], references: [id])
}

model PerformanceHistory {
  id          String   @id @default(uuid())
  studentId   String
  date        DateTime
  subject     String
  accuracy    Float
  completion  Float

  student     Student  @relation(fields: [studentId], references: [id])

  @@unique([studentId, date, subject])
}
